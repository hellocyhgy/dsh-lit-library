{
  "name": "dsh-lit-library",
  "version": "0.1.1",
  "type": "module",
  "description": "Import papers into a governed literature library: extract text, append one index row, and verify every quote.",
  "license": "MIT",
  "author": "hellocyhgy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hellocyhgy/dsh-lit-library.git"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "literature",
    "pdf",
    "knowledge-base",
    "citation"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "unpdf": "^1.9.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.2.1-0 || >=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
